{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "JobTracker": "Host=localhost;Port=5432;Database=jobtracker;Username=jobtracker;Password=jobtracker"
  },
  "Database": {
    "AutoMigrate": false
  },
  "Jwt": {
    "Enabled": false,
    "Authority": "",
    "Issuer": "",
    "Audience": "",
    "OrganizationClaim": "org_id",
    "RequireHttpsMetadata": true
  },
  "Idempotency": {
    "Enabled": true,
    "HeaderName": "Idempotency-Key",
    "MaxKeyLength": 128,
    "TtlHours": 24
  },
  "Outbox": {
    "Enabled": true,
    "PollingIntervalSeconds": 5,
    "BatchSize": 32,
    "MaxAttempts": 5
  },
  "FileStorage": {
    "RootPath": "wwwroot/uploads",
    "PublicBaseUrl": "/uploads",
    "MaxSizeBytes": 10485760,
    "AllowedContentTypes": ["image/jpeg", "image/png", "image/webp"]
  },
  "AllowedHosts": "*"
}
